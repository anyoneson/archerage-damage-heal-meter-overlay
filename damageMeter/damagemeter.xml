<Ui xmlns="http://www.archeagegame.com/ui">
  <!-- Janela principal do medidor -->
  <Window name="DamageMeterWindow" width="300" height="400" movable="true" visible="true" frameStrata="HIGH" toplevel="true">
    <Label name="TitleLabel" text="Damage Meter" x="10" y="10" width="280" height="30" font="ChatFontNormal"/>
    <ListBox name="DamageList" x="10" y="50" width="280" height="320" font="ChatFontNormal"/>
    <Button name="SettingsButton" text="Settings" x="10" y="380" width="80" height="20" font="ChatFontNormal"/>
    <Button name="ResetButton" text="Reset" x="100" y="380" width="80" height="20" font="ChatFontNormal"/>
  </Window>

  <!-- Janela de configurações -->
  <Window name="DamageMeterSettingsWindow" width="300" height="250" movable="true" visible="false" frameStrata="HIGH" toplevel="true">
    <Label name="SettingsTitleLabel" text="Damage Meter Settings" x="10" y="10" width="280" height="30" font="ChatFontNormal"/>
    
    <!-- Configurações de exibição -->
    <Label name="ShowHealingLabel" text="Show Healing:" x="10" y="50" width="120" height="20" font="ChatFontNormal"/>
    <CheckBox name="ShowHealingCheckbox" x="140" y="50" width="20" height="20"/>
    
    <Label name="TimeWindowLabel" text="Time Window (min):" x="10" y="80" width="120" height="20" font="ChatFontNormal"/>
    <EditBox name="TimeWindowEdit" x="140" y="80" width="50" height="20" font="ChatFontNormal"/>
    
    <Label name="TargetNameLabel" text="Target Name:" x="10" y="110" width="120" height="20" font="ChatFontNormal"/>
    <EditBox name="TargetNameEdit" x="140" y="110" width="120" height="20" font="ChatFontNormal"/>
    
    <!-- Configurações de interface -->
    <Label name="OpacityLabel" text="Window Opacity:" x="10" y="140" width="120" height="20" font="ChatFontNormal"/>
    <Slider name="OpacitySlider" x="140" y="140" width="120" height="20" minValue="0" maxValue="100" defaultValue="100"/>
    
    <Label name="FontSizeLabel" text="Font Size:" x="10" y="170" width="120" height="20" font="ChatFontNormal"/>
    <Slider name="FontSizeSlider" x="140" y="170" width="120" height="20" minValue="8" maxValue="20" defaultValue="12"/>
    
    <!-- Botões -->
    <Button name="SettingsSaveButton" text="Save" x="10" y="210" width="80" height="20" font="ChatFontNormal"/>
    <Button name="SettingsCancelButton" text="Cancel" x="100" y="210" width="80" height="20" font="ChatFontNormal"/>
  </Window>
</Ui> 