{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArcheRage Meter",
  "version": "0.1.0",
  "identifier": "com.xizde.archerage-meter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ArcheRage - Damage/Heal Meter",
        "width": 330,
        "height": 270,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../icon.ico"]
  }
}
